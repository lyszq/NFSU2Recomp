/* Authored harness template. The substituted values come from PRIVATE original
 * x86 execution. Do not commit the generated version under gen/ios-private. */
#include "guest_execution.h"
#include "guest_bootstrap.h"
#include "guest_memory.h"
#include "guest_windows.h"
#include "guest_cursor.h"
#include <errno.h>
#include <inttypes.h>
#include <stdio.h>
#include <string.h>
extern const uint32_t nfs_startup_addresses[], nfs_startup_count;
extern const GuestFunction nfs_startup_functions[];
extern const GuestImport nfs_startup_imports[];
extern const uint32_t nfs_startup_import_count;
#ifdef NFS_PRIVATE_TRACE
extern void nfs_private_trace_memory(const char *, uint32_t, size_t);
extern void nfs_private_trace_finish(const GuestPEImage *);
#endif
static uint64_t memory_hash(const void *source, size_t size) {
    const uint8_t *bytes = source;
    uint64_t hash = UINT64_C(14695981039346656037);
    for (size_t i = 0; i < size; ++i) { hash ^= bytes[i]; hash *= UINT64_C(1099511628211); }
    return hash;
}
int nfs_private_startup_probe(const GuestPEImage *image, char *out, size_t capacity) {
    GuestDispatch table = {0};
    CPU context;
    CPU *c = &context;
    GuestExecutionResult result = {0};
    GuestWindows windows={.image_base=image->image_base, .resource_image=*image};
    int cursor_fixture_started = 0;
    int rc = guest_execution_bind_imports(image, nfs_startup_imports, nfs_startup_import_count);
    if (rc) goto failed;
    rc = guest_bootstrap_init(c, image);
    if (rc) goto failed;
    rc = guest_process_init(&windows.process, image);
    if (rc) goto failed;
    rc = guest_clock_fixture_init(&windows.clock, UINT64_C(1000000), UINT64_C(1000000), UINT64_C(1000));
    if (rc) goto failed;
    rc = guest_dispatch_init(&table, 0x00401000u, 0x00381af1u,
                             nfs_startup_addresses, nfs_startup_functions, nfs_startup_count);
    if (rc) goto failed;
    GuestExecutionConfig config = {.dispatch=&table, .imports=nfs_startup_imports,
        .import_count=nfs_startup_import_count, .instruction_budget=200000u,
        .depth_limit=64u, .timeout_ns=UINT64_C(2000000000), .import_handler=guest_windows_import,
        .import_context=&windows,
        /* Explicit bounded-test clock, unrelated to host or gameplay time. */
        .virtual_tsc_initial=UINT64_C(1000000), .virtual_tsc_increment=UINT64_C(1000)};
    PUSH32(0xdeadc0deu);
    /* A declared per-thread test input, never a claim of live UIKit input.
     * Host events continue to update the separate live cursor snapshot. */
    if (guest_cursor_is_synthetic()) { rc = EBUSY; goto failed; }
    guest_cursor_inject_synthetic(320, 180, GUEST_CURSOR_FLAG_AVAILABLE);
    cursor_fixture_started = 1;
    rc = guest_execution_run(&config, c, image->entry_point, &result);
    guest_cursor_clear_synthetic();
    cursor_fixture_started = 0;
    if (rc) goto failed;
#ifdef NFS_PRIVATE_TRACE
    nfs_private_trace_finish(image);
    nfs_private_trace_memory("stack", @STACK_WINDOW_ADDRESS@, @STACK_WINDOW_SIZE@);
    nfs_private_trace_memory("heap", @HEAP_WINDOW_ADDRESS@, @HEAP_WINDOW_SIZE@);
    nfs_private_trace_memory("process", @PROCESS_WINDOW_ADDRESS@, @PROCESS_WINDOW_SIZE@);
#endif
    const uint32_t expected_heaps[][4]={@EXPECTED_HEAPS@};
    const uint32_t expected_blocks[][5]={@EXPECTED_BLOCKS@};
    unsigned heap_count=0, block_count=0;
    int metadata_match=1;
    /* The entry fixture is explicit; normal Windows contexts use live time. */
    if (windows.clock.mode != 1u || windows.clock.frequency != UINT64_C(@EXPECTED_CLOCK_FREQUENCY@) ||
        windows.clock.next != UINT64_C(@EXPECTED_CLOCK_NEXT@) ||
        windows.clock.increment != UINT64_C(@EXPECTED_CLOCK_INCREMENT@) ||
        windows.clock.query_count != UINT64_C(@EXPECTED_CLOCK_QUERIES@) ||
        windows.clock.sample_count != UINT64_C(@EXPECTED_CLOCK_SAMPLES@) ||
        windows.clock.trace_hash != UINT64_C(@EXPECTED_CLOCK_HASH@)) metadata_match=0;
    const uint32_t expected_snapshots[GUEST_TOOLHELP_SNAPSHOT_LIMIT][4] = {@EXPECTED_SNAPSHOTS@};
    if (windows.toolhelp.count != @EXPECTED_SNAPSHOT_COUNT@) metadata_match=0;
    for (unsigned i=0; i<GUEST_TOOLHELP_SNAPSHOT_LIMIT; ++i) {
        const GuestToolhelpSnapshot *snap=&windows.toolhelp.snapshots[i];
        const uint32_t actual[]={snap->handle,snap->process_id,snap->iter_index,snap->active};
        if (memcmp(actual,expected_snapshots[i],sizeof actual)) metadata_match=0;
    }
    const uint32_t expected_user_objects[GUEST_USER_OBJECT_LIMIT][6] = {@EXPECTED_USER_OBJECTS@};
    if (windows.user_objects.count != @EXPECTED_USER_OBJECT_COUNT@) metadata_match=0;
    for (unsigned i=0; i<GUEST_USER_OBJECT_LIMIT; ++i) {
        const GuestUserObject *obj=&windows.user_objects.entries[i];
        const uint32_t actual[]={obj->handle,(uint32_t)obj->type,(uint32_t)obj->source,
                                 obj->module,obj->resource_id,obj->shared};
        if (memcmp(actual,expected_user_objects[i],sizeof actual)) metadata_match=0;
        if (obj->handle && guest_user_objects_lookup(&windows.user_objects, obj->handle,
                (GuestUserObjectType)expected_user_objects[i][1]) != obj) metadata_match=0;
    }
    for (unsigned h=0;h<GUEST_HEAP_MAX_HEAPS;h++) {
        const GuestHeap *heap=&windows.heaps.heaps[h];
        heap_count+=heap->handle!=0;
        for (unsigned b=0;b<GUEST_HEAP_MAX_BLOCKS;b++) block_count+=heap->blocks[b].address!=0;
    }
    if (heap_count!=sizeof expected_heaps/sizeof expected_heaps[0] ||
        block_count!=sizeof expected_blocks/sizeof expected_blocks[0]) metadata_match=0;
    for (unsigned i=0;i<sizeof expected_heaps/sizeof expected_heaps[0];i++) {
        const uint32_t *v=expected_heaps[i];
        const GuestHeap *heap=&windows.heaps.heaps[v[0]];
        if (heap->handle!=v[1] || heap->capacity!=v[2] || heap->fixed!=v[3]) metadata_match=0;
    }
    for (unsigned i=0;i<sizeof expected_blocks/sizeof expected_blocks[0];i++) {
        const uint32_t *v=expected_blocks[i];
        const GuestHeapBlock *block=&windows.heaps.heaps[v[0]].blocks[v[1]];
        if (block->address!=v[2] || block->size!=v[3] || block->span!=v[4]) metadata_match=0;
    }
    const uint32_t expected_registers[] = {@EXPECTED_GPRS@};
    int steps_ok = result.instructions == @EXPECTED_STEPS@;
    int trace_ok = result.trace_hash == UINT64_C(@EXPECTED_TRACE@);
    int calls_ok = result.calls == @EXPECTED_CALLS@;
    int img_ok = memory_hash(g_mem + image->image_base, image->image_size) == UINT64_C(@EXPECTED_IMAGE_HASH@);
    int stak_ok = memory_hash(g_mem + @STACK_WINDOW_ADDRESS@, @STACK_WINDOW_SIZE@) == UINT64_C(@EXPECTED_STACK_HASH@);
    int heap_ok = memory_hash(g_mem + @HEAP_WINDOW_ADDRESS@, @HEAP_WINDOW_SIZE@) == UINT64_C(@EXPECTED_HEAP_HASH@);
    if (result.stop != GUEST_STOP_IMPORT || result.target != @EXPECTED_TARGET@ ||
        result.ip != @EXPECTED_IP@ || !steps_ok ||
        result.virtual_tsc_next != UINT64_C(@EXPECTED_TSC_NEXT@) ||
        result.virtual_tsc_reads != UINT64_C(@EXPECTED_TSC_READS@) ||
        result.virtual_tsc_hash != UINT64_C(@EXPECTED_TSC_HASH@) ||
        result.imports_handled != @EXPECTED_APIS@ ||
        guest_critical_count(&windows.critical) != @EXPECTED_CRITICALS@ ||
        guest_tls_count(&windows.tls) != @EXPECTED_TLS@ ||
        windows.tls.count != @EXPECTED_TLS_THREADS@ || !metadata_match ||
        windows.process.environment_a_refs != @EXPECTED_ENV_A_REFS@ ||
        windows.process.environment_w_refs != @EXPECTED_ENV_W_REFS@ ||
        !calls_ok || result.maximum_depth != @EXPECTED_DEPTH@ ||
        c->eip != @EXPECTED_IP@ || c->fs_base != GUEST_TEB_BASE || c->gs_base != GUEST_TEB_BASE ||
        !trace_ok ||
        memcmp(c->r, expected_registers, sizeof c->r) ||
        (eflags_get(c) & 0x200cd5u) != @EXPECTED_FLAGS@ ||
        !img_ok ||
        memory_hash(g_mem + GUEST_TEB_BASE, 0x20000u) != UINT64_C(@EXPECTED_TEB_HASH@) ||
        !guest_memory_pointer(@HEAP_WINDOW_ADDRESS@, @HEAP_WINDOW_SIZE@, 0) ||
        !heap_ok ||
        !stak_ok ||
        !guest_memory_pointer(@PROCESS_WINDOW_ADDRESS@, @PROCESS_WINDOW_SIZE@, 0) ||
        memory_hash(g_mem + @PROCESS_WINDOW_ADDRESS@, @PROCESS_WINDOW_SIZE@) != UINT64_C(@EXPECTED_PROCESS_HASH@)) {
        rc = EINVAL;
        (void)snprintf(out, capacity,
            "FAIL | entry mismatch | stop=%u ip=%08x target=%08x depth=%u(exp %u) apis=%" PRIu64 "(exp %u) "
            "steps=%" PRIu64 "(exp %" PRIu64 ") calls=%" PRIu64 "(exp %" PRIu64 ") "
            "trace=%016" PRIx64 "(exp %016" PRIx64 ") "
            "r=[%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x] "
            "img=%016" PRIx64 " stak=%016" PRIx64 " heap=%016" PRIx64,
            (unsigned)result.stop, result.ip, result.target, result.maximum_depth, (unsigned)@EXPECTED_DEPTH@,
            result.imports_handled, (unsigned)@EXPECTED_APIS@,
            result.instructions, (uint64_t)@EXPECTED_STEPS@, result.calls, (uint64_t)@EXPECTED_CALLS@,
            result.trace_hash, UINT64_C(@EXPECTED_TRACE@),
            c->r[0], c->r[1], c->r[2], c->r[3], c->r[4], c->r[5], c->r[6], c->r[7],
            memory_hash(g_mem + image->image_base, image->image_size),
            memory_hash(g_mem + @STACK_WINDOW_ADDRESS@, @STACK_WINDOW_SIZE@),
            memory_hash(g_mem + @HEAP_WINDOW_ADDRESS@, @HEAP_WINDOW_SIZE@));
        goto cleanup;
    }
    const GuestImport *import = &nfs_startup_imports[result.import_index];
    (void)snprintf(out, capacity,
        "VERIFIED ENTRY STOP | 0075bcc7 -> %08x | %s!%s not implemented | "
        "%" PRIu64 " instructions / %" PRIu64 " dispatch calls / %u registered functions | "
        "%" PRIu64 " implemented API calls / %u native critical sections / %u TLS keys | "
        "x86 trace + GPR/EFLAGS + image/TEB/stack/heap/process match | "
        "leaf regression PASS | cursor fixture (320,180) | virtual TSC + clock fixtures | no JIT | no game boot",
        result.ip, import->library, import->name, result.instructions, result.calls, nfs_startup_count,
        result.imports_handled,guest_critical_count(&windows.critical),guest_tls_count(&windows.tls));
    goto cleanup;
failed:
    (void)snprintf(out, capacity, "FAIL | native entry setup/execution | error=%d", rc);
cleanup:
    if (cursor_fixture_started) guest_cursor_clear_synthetic();
    guest_dispatch_destroy(&table);
    {
        int cleanup_rc=guest_windows_cleanup(&windows);
        if (cleanup_rc) {
            rc=cleanup_rc;
            (void)snprintf(out, capacity, "FAIL | native host resource cleanup | error=%d", rc);
        }
    }
    return rc;
}
